  "autoCommands": {
    "enabled": false,
    "onSpawn": [
      {
        "command": "/use 4",
        "delay": 4000,
        "awaitCompletion": true
      },
      {
        "command": "/click 20",
        "delay": 0,
        "awaitCompletion": true
      },
      {
        "command": "/home",
        "delay": 10000,
        "awaitCompletion": true
      },
      {
        "command": "/mine",
        "delay": 7000,
        "awaitCompletion": false
      }
    ],
    "onDeath": []
  },
  "antiAFK": {
    "enabled": false,
    "intervalSeconds": 120,
    "action": "sneak"
  },
  "autoRespawn": {
    "enabled": true,
    "delay": 1000
  },
  "chatLog": {
    "enabled": false,
    "directory": "logs"
  },
  "mine": {
    "capdaoEnabled": false,
    "capdaoLevel": 50
  },
  "coop": {
    "enabled": true,
    "owner": "VexDex",
    "members": [
      "Ruoooo",
      "Vex1",
      "Vex2",
      "Vex3"
    ]
  },
  "chatGames": {
    "enabled": true,
    "delayMs": 1000,
    "disabledAccounts": [],
    "toolTitle": {
      "enabled": true,
      "normalEnabled": false,
      "multiplyEnabled": false,
      "wordEnabled": false,
      "normalMinDelayMs": 0,
      "normalMaxDelayMs": 0,
      "multiplyMinDelayMs": 0,
      "multiplyMaxDelayMs": 0,
      "wordMinDelayMs": 0,
      "wordMaxDelayMs": 0,
      "benchmark": false,
      "debug": false
    }
  },
  "antiBot": {
    "enabled": "auto",
    "brand": {
