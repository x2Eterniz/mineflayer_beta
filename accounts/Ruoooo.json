{
  "server": {
    "host": "play.soulmc.vn",
    "port": 25565,
    "version": false,
    "viewDistance": "tiny",
    "pingBeforeConnect": false
  },
  "bot": {
    "username": "Ruoooo",
    "auth": "offline",
    "hideErrors": true,
    "profilesFolder": "./nmp-cache",
    "promptBeforeJoin": false
  },
  "reconnect": {
    "enabled": true,
    "delay": 5000,
    "maxAttempts": 10
